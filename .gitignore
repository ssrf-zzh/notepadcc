# 构建产物
/build/
/build-*/
/out/
# 发行打包产物（scripts/package.ps1 生成）
/dist/
# 构建期下载的本地工具（WiX 等；不入库）
/.build-tools/
*.obj
*.o
*.pdb
*.ilk
*.exe

# 签名私钥：只放离线签发环境，绝不入库、不进发行包
/keys/
*.pfx
*.p12
*.key
*.pem

# 第三方源码（由 scripts/fetch_deps.ps1 拉取，不入库）
/third_party/_dl/
/third_party/scintilla/
/third_party/lexilla/
/third_party/pcre2/
/third_party/_stage/

# 运行时配置（便携模式下会出现在这里）
/config/

# 原始设计素材：成品图标已放入 res/，原图不入库也不进源码包
/我的徽标.png

# 编辑器与系统
.vs/
.vscode/
__pycache__/
*.pyc
*.user
Thumbs.db
desktop.ini
~$*
