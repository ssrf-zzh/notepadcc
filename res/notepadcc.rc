#include <windows.h>

/* 清单：DPI 感知、通用控件 v6、长路径支持 */
1 RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName",      "notepadcc"
            VALUE "FileDescription",  "notepadcc text editor"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "notepadcc"
            VALUE "OriginalFilename", "notepadcc.exe"
            VALUE "ProductName",      "notepadcc"
            VALUE "ProductVersion",   "1.0.0.0"
            VALUE "LegalCopyright",   "Copyright (C) 2026"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
